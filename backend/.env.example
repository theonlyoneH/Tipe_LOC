# ==============================================================================
# TIPE Backend - environment variables
# Copy to backend/.env and fill in the values:  cp .env.example .env
# Never commit backend/.env. Only this example file belongs in git.
# Commented-out lines show the default the app uses when the variable is unset.
# ==============================================================================

# ---------- Required ----------
# MongoDB connection string (Atlas or local, e.g. mongodb://localhost:27017)
MONGO_DETAILS=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# ---------- Server ----------
# PORT=8005
# MONGO_DB=proexport_db
# Login token lifetime in hours
# TOKEN_TTL_HOURS=24
# CORS: comma-separated frontend origins. "*" allows any origin (no credentials).
# ALLOWED_ORIGINS=https://tipe-theta.vercel.app,http://localhost:5173

# ---------- LLM (set at least ONE; comma-separated keys rotate round-robin) ----------
GROQ_API_KEYS=
# GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_SECONDS=30

# ---------- Pinecone (integrated-embedding index) ----------
PINECONE_API_KEY=
PINECONE_INDEX=
# PINECONE_NAMESPACES=exporters,importers,globalnews
# PINECONE_TOP_K=10

# ---------- News ----------
# NEWS_CACHE_SECONDS=600
# NEWS_MAX_ARTICLES=25
# Extra RSS feeds (comma-separated)
# NEWS_EXTRA_FEEDS=https://feeds.bbci.co.uk/news/business/rss.xml

# ---------- Leads & ranking engine ----------
# Max leads returned per request
# LEADS_MAX=200
# News weight per market regime
# NEWS_WEIGHTS=calm:0.15,active:0.30,boom:0.35,shock:0.45
# Regime detection: headlines considered, strength thresholds, risk-headline share
# REGIME_TOP_N=8
# REGIME_ACTIVE=0.25
# REGIME_HIGH=0.42
# REGIME_RISK_SHARE=0.45
# Random forest kicks in after this many swipes (needs >=2 approvals and >=2 rejections)
# RF_MIN_DECISIONS=8
# RF_TREES=80
# Hours until an old swipe counts half
# FEEDBACK_HALF_LIFE_HOURS=72

# ---------- Demo vs real users ----------
# These accounts see the bundled demo dataset; everyone else gets real scraped companies.
# DEMO_USER_EMAILS=test@gmail.com

# ---------- Lead scraper (Wikidata + GLEIF + public company websites) ----------
# Shown in the scraper's User-Agent so site owners can reach you (URL or email)
SCRAPER_CONTACT=https://your-site.example/contact
# Re-scrape an industry after this many hours
# SCRAPE_TTL_HOURS=24
# SCRAPE_MAX_COMPANIES=1500
# Websites/registries checked per worker run, and right after a new user signs up
# SCRAPE_ENRICH_PER_RUN=120
# SCRAPE_ENRICH_ON_DEMAND=25
# Re-enrich a company once its data is older than this many days
# SCRAPE_ENRICH_MAX_AGE_DAYS=14
# Industries to keep warm even before anyone signs up (comma-separated)
# SCRAPE_INDUSTRIES=Textiles,Pharmaceuticals,Auto Parts
# Let the API start a scrape when a new user's industry has no cache (true/false)
# SCRAPE_ON_DEMAND=true

# ---------- Optional SMTP: when set, approved email-channel messages are really sent ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
