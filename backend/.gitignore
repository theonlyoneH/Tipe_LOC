# ==============================================================================
# TIPE Backend .gitignore
# ==============================================================================

# Secrets & Environment variables
.env
.env.*
!.env.example
*.env
!*.env.example
*.pem
*.key

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & builds
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/

# Testing & Linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Logs & temp files
logs/
*.log
.cache/
temp/
tmp/
*.sqlite
*.sqlite3
*.db

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
