# ==============================================================================
# TIPE Frontend (Vite) - environment variables
# Copy to .env and adjust:  cp .env.example .env
# VITE_* values are bundled into the public JS, so never put secrets here.
# On Vercel, set these in Project Settings -> Environment Variables.
# ==============================================================================

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8005

# Optional: custom map tiles (defaults to free OpenStreetMap tiles)
# VITE_MAP_TILES=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
